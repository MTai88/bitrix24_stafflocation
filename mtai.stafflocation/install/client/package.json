{
  "name": "mtai-stafflocation-client",
  "version": "1.0.0",
  "description": "Vue 3 + Vite client of the mtai.stafflocation Bitrix24 module (office floor map)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not IE 11"
